[Unit]
Description=ProxAI apps server (read-only: lists ProxAI-built apps, serves their APKs to ProxMobile)
Documentation=file://%h/dev/projects/ProxMobile/docs/PROXAI-APPS.md
Requires=proxai-apps.socket
After=proxai-apps.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I %h/dev/projects/ProxMobile/server/proxai_apps_server.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# Sees only the apps folder (read-only, signing key hidden), the thermal watch output (read-only),
# the API key file and its own code.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
# Socket activation hands over the listening socket, so the server needs no network of its own.
PrivateNetwork=yes
BindReadOnlyPaths=%h/dev/proxai/apps %h/.hermes/profiles/proxai/.env %h/dev/projects/ProxMobile/server -%h/.local/state/proxai/thermal-watch -%h/.local/state/proxai/context -%h/.local/state/proxai/notices -%h/.local/state/proxai/scout
# The one writable folder: the scout gig board's change requests (proxai-scout applies them).
BindPaths=-%h/.local/state/proxai/scout/inbox
InaccessiblePaths=-%h/dev/proxai/apps/.signing
