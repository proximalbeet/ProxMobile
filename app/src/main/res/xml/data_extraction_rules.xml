<?xml version="1.0" encoding="utf-8"?>
<!-- OWNER-SIGN review round (0.9.16): nothing of ProxMobile's leaves the phone in a backup or a phone-to-phone
     transfer: not its preferences (the server key, the Prox Dump sync and Owner tokens, the owner key pin, the pinned
     apps key), not its databases or files. android:allowBackup="false" already stops backups up to Android 11; from
     Android 12 some phones still allow device-to-device transfer unless these rules exclude it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
